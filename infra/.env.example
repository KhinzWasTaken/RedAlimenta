# Copia este archivo como infra/.env y cambia las claves. infra/.env no se sube al repositorio.
# Lo leen docker compose y los scripts de scripts/ (bd.py, probar.py, levantar.py).

# PostgreSQL (Sprint 4)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
APP_DB_PASSWORD=cambia-esta-otra
POSTGRES_PORT=5432

# RabbitMQ (Sprint 5)
RABBITMQ_USER=redalimenta
RABBITMQ_PASSWORD=cambia-esta-clave-de-rabbit
RABBITMQ_PORT=5672
RABBITMQ_CONSOLA_PORT=15672

# Secretos compartidos por los servicios (Sprint 5). Usa textos largos y aleatorios.
# JWT_SECRETO firma los tokens de sesión; TOKEN_INTERNO autoriza las llamadas entre servicios.
JWT_SECRETO=cambia-por-un-texto-largo-y-aleatorio
TOKEN_INTERNO=cambia-por-otro-texto-largo-y-aleatorio
