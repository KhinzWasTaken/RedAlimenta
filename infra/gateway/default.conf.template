# GENERADO por scripts/gateway.py desde infra/rutas.json. No editar a mano.
# Gateway de RedAlimenta (S6-03): única dirección pública. Sirve el frontend y reparte /api por servicio.
# Las rutas /internal (servicio a servicio, D-01) no se publican.

map $http_x_correlation_id $correlacion {
    ""      $request_id;
    default $http_x_correlation_id;
}

log_format redalimenta '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                       '${request_time}s corr=$correlacion upstream=$upstream_addr';

server {
    listen 8080;
    server_name _;
    access_log /dev/stdout redalimenta;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    client_max_body_size 1m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Correlation-Id $correlacion;
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
    proxy_hide_header X-Correlation-Id;  # la pone el gateway una sola vez
    add_header X-Correlation-Id $correlacion always;

    location = /salud {
        default_type application/json;
        return 200 '{"estado":"ok","servicio":"gateway"}';
    }

    # Rutas internas entre servicios: nunca desde afuera
    location ^~ /internal {
        default_type application/json;
        return 404 '{"detail":"Recurso no encontrado"}';
    }

    location ^~ /api/admin/verificaciones {
        set $destino http://identity${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/admin/categorias {
        set $destino http://catalog${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/admin/auditoria {
        set $destino http://identity${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/admin/usuarios {
        set $destino http://identity${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/notificaciones {
        set $destino http://notification${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/necesidades {
        set $destino http://catalog${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/categorias {
        set $destino http://catalog${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/donaciones {
        set $destino http://catalog${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/historial {
        set $destino http://analytics${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/usuarios {
        set $destino http://identity${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/reservas {
        set $destino http://fulfillment${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/entregas {
        set $destino http://fulfillment${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/tareas {
        set $destino http://fulfillment${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/auth {
        set $destino http://identity${DOMINIO_SERVICIOS}:8000;
        proxy_pass $destino;
    }

    location ^~ /api/ {
        default_type application/json;
        return 404 '{"detail":"Recurso no encontrado"}';
    }

    # Frontend compilado (SPA): cualquier otra ruta devuelve index.html
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
